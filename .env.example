# Supabase/PostgreSQL
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: explicit local/demo fallback when Supabase is not configured.
# Do not use this to fake authentication for a production deployment.
NEXT_PUBLIC_ADAPTIVA_DEMO_MODE=true

# AI provider configuration. Keep API keys server-side only.
AI_PROVIDER=demo
AI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
